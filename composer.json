{
  "name": "veronalabs/spamlens",
  "description": "Spam protection for WordPress comments, reviews and Contact Form 7, powered by Jev (TypeSafe AI).",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/veronalabs/spamlens",
  "keywords": [
    "wordpress",
    "wordpress-plugin",
    "spam",
    "anti-spam",
    "comments",
    "contact-form-7"
  ],
  "authors": [
    {
      "name": "VeronaLabs",
      "email": "dev@veronalabs.com",
      "homepage": "https://veronalabs.com"
    }
  ],
  "support": {
    "issues": "https://github.com/veronalabs/spamlens/issues",
    "source": "https://github.com/veronalabs/spamlens"
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "phpunit/phpunit": "^9.6",
    "veronalabs/wp-scoper": "^1.4",
    "wp-coding-standards/wpcs": "^3.4.1",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "SpamLens\\": "src/"
    }
  },
  "extra": {
    "wp-scoper": {
      "namespace_prefix": "SpamLens\\Dependencies",
      "class_prefix": "SpamLens_",
      "constant_prefix": "SPAMLENS_",
      "packages": [],
      "target_directory": "packages",
      "delete_vendor_packages": true,
      "exclude_directories": [
        "views",
        "resources",
        "public"
      ]
    }
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "7.4.33"
    },
    "platform-check": false,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "veronalabs/wp-scoper": true
    },
    "sort-packages": true
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpcbf": "phpcbf",
    "test": "phpunit",
    "build": "composer install --no-dev --optimize-autoloader --classmap-authoritative",
    "dist": "bash bin/build-zip.sh"
  }
}
